# Supabase Edge Function secrets, set with:
# supabase secrets set BLOG_ADMIN_KEY=...
BLOG_ADMIN_KEY=
# Use a randomly generated secret of at least 32 characters. Never use VITE_ for secrets.
# Existing shorter admin keys must be rotated before deploying the hardened function.
BLOG_ADMIN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
